{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    "preserveSymlinks": true,

    "target": "ES2022",
    "lib": ["ES2022"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "rootDirs": ["./src"],
    "paths": {
      "@*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["node_modules", "coverage", "test"]
}

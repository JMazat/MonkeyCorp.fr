{
    "preset": "ts-jest",
    "testEnvironment": "node",

    "roots": ["<rootDir>/test"],
    "moduleFileExtensions": ["js", "ts", "tsx"],
    "moduleDirectories": ["node_modules", "<rootDir>"],
    "moduleNameMapper": {
        "^@jest(.*)$": "@jest$1",
        "^@babel(.*)$": "@babel$1",

        "^@test/(.*)$": "<rootDir>/test/$1",
        "^@(.*)$": "<rootDir>/src/$1"
    },

    "clearMocks": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",

    "transform": {
        "^.+\\.tsx?$": "ts-jest"
    }
}
